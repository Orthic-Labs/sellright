# SellRight API — example environment.
# Copy to .env and fill in. Every var here is read by the code (env.ts EnvSchema
# or a documented raw-process.env reader); nothing phantom. All optional vars boot
# with safe defaults when unset.

# --- Core -------------------------------------------------------------------
PORT=3300
NODE_ENV=development

# Postgres — dev/test cluster is the NATIVE :5433 cluster on the box.
# NEVER point at :5432 — that is the live Vendure prod (vendure-postgres Docker).
DATABASE_URL=postgres://sellright:CHANGE_ME@127.0.0.1:5433/sellright_dev
# Non-owner role (NOSUPERUSER NOBYPASSRLS) used by the RLS test suite to prove
# tenant isolation under FORCE RLS. Falls back to DATABASE_URL when unset.
DATABASE_URL_NONOWNER=postgres://sellright_app:CHANGE_ME@127.0.0.1:5433/sellright_dev

# --- Email (WP2) — all optional; mailer no-ops + logs when SMTP_HOST is unset --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sellright.local
# Force the no-op mail path even when SMTP_HOST is set (load tests, demos): true|false
SMTP_ENABLED=

# --- Assets (WP8) / storefront links ----------------------------------------
ASSET_DIR=/home/vendure/sites/sellright-assets
STOREFRONT_URL=https://store.example.com

# --- Payments (WP3) — Stripe only is implemented. Test keys only in dev. -----
# Endpoints 503 / no-op when unset, so dev/tests boot without a key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Auth -------------------------------------------------------------------
# Google OAuth client id (storefront SSO). Per-store store.config.googleClientId
# overrides this; this is the fallback.
GOOGLE_CLIENT_ID=

# --- Admin bootstrap scripts (seed-admin, provision-right-apps) -------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Import scripts (catalog/customers/orders <- Vendure clone) -------------
# Read-only Vendure source DB to import from.
SOURCE_DATABASE_URL=postgres://cp:cp@127.0.0.1:5433/damned_vendure
# TRUNCATE guard override. The importers refuse to truncate a non *_dev/_test DB
# unless BOTH --force argv AND this =1 are set.
# ⚠ DANGER: '1' in production permits mass data deletion. Leave unset.
ALLOW_FORCE_TRUNCATE=

# --- Manifest generator -----------------------------------------------------
CATALOG_DIR=/home/vendure/sites/sellright-data
STORE_SLUG=damned

# --- Job scheduler (setInterval; NO Redis/BullMQ). Master switch off by default --
JOBS_ENABLED=
# auto-deliver: actually transition Shipped->Delivered (else dry-run log)
JOBS_AUTO_DELIVER_APPLY=
JOBS_AUTO_DELIVER_DAYS=10
# release-stale-allocations: actually cancel+release unpaid orders (else dry-run)
# ⚠ DANGER: enabling against imported historical PendingPayment orders mass-cancels them.
JOBS_RELEASE_STALE_APPLY=
JOBS_RELEASE_STALE_TTL_MIN=60
# webhook-reaper: actually reset stuck 'processing' rows (else dry-run)
JOBS_WEBHOOK_REAPER_APPLY=
JOBS_WEBHOOK_REAPER_GRACE_MIN=10

# --- Storefront (Vite) build-time vars --------------------------------------
VITE_SELLRIGHT_API_URL=http://127.0.0.1:3300
VITE_SELLRIGHT_STORE_SLUG=damned
