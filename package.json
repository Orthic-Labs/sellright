{
  "name": "sellright",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15 <25 || >=26 <27",
    "pnpm": ">=11.25 <12"
  },
  "scripts": {
    "build": "pnpm -r build && pnpm --dir packages/admin build",
    "typecheck": "pnpm -r typecheck && pnpm --dir packages/admin typecheck",
    "test": "pnpm --filter @sellright/api test",
    "verify:static": "pnpm -r build && pnpm -r typecheck && pnpm --dir packages/admin typecheck && pnpm --dir packages/admin build && pnpm --filter @sellright/api test && pnpm --filter @sellright/api assert:agent-boundary && pnpm --filter @sellright/storefront-client test && pnpm assert:no-vendure && pnpm assert:no-vendure:test && pnpm --filter @sellright/storefront-client generate:check",
    "verify:db": "pnpm --filter @sellright/api db:assert-rls && pnpm --filter @sellright/api db:assert-hand-written && pnpm --filter @sellright/api assert:shop-isolation && pnpm --filter @sellright/api assert:settlement",
    "verify": "pnpm verify:static && pnpm verify:db",
    "assert:no-vendure": "bash scripts/assert-no-vendure.sh",
    "assert:no-vendure:test": "node --test scripts/assert-no-gql-tags.test.mjs",
    "assert:no-node-eval": "bash scripts/assert-no-node-eval.sh",
    "dev": "pnpm --filter @sellright/api dev",
    "admin:typecheck": "pnpm --dir packages/admin typecheck",
    "admin:build": "pnpm --dir packages/admin build",
    "qa:browser": "pnpm --dir packages/admin qa:browser",
    "audit:lint": "eslint .",
    "audit:dead-code": "knip --reporter json",
    "audit:duplication": "jscpd . --reporters json --output .cache/jscpd --silent",
    "deps:check": "pnpm outdated -r || true; pnpm --dir packages/admin outdated || true",
    "deps:audit": "pnpm audit && pnpm --dir packages/admin audit",
    "deps:update": "pnpm up -r && pnpm --dir packages/admin up",
    "deps:update:latest": "pnpm up -r --latest && pnpm --dir packages/admin up --latest",
    "test:sdk-packed": "pnpm --filter @sellright/sample-plugin test",
    "release:doctor": "right-release doctor"
  },
  "devDependencies": {
    "@rightkit/release": "0.6.4",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.13.0",
    "jscpd": "^5.4.2",
    "knip": "^6.42.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
