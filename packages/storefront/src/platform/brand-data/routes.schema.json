{
  "$comment": "src/brand/routes.json, PR1 part (content paths, per-page head, blog page size). Path rules beyond the shapes (reserved prefixes, existing routes, duplicates, `pages` keys) are checked by src/platform/content-routes.ts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "content": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "pageKey"],
        "properties": {
          "path": { "type": "string", "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)+/$", "maxLength": 120 },
          "pageKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 60 },
          "head": { "$ref": "#/definitions/pageHead" }
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "head": { "$ref": "#/definitions/pageHead" } }
      }
    },
    "blog": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 } }
    }
  },
  "required": ["version"],
  "definitions": {
    "pageHead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 320 },
        "noindex": { "type": "boolean" }
      }
    }
  }
}
