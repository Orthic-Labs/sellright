{
  "$comment": "src/brand/routes.json (content paths, per-page head, blog page size; PR2: productPath, shop configurator products, operational aliases). Path rules beyond the shapes (reserved prefixes, existing routes, duplicates, `pages` keys, detail product head schemas) are checked by src/platform/content-routes.ts and validate.ts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "content": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "pageKey"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)+/$",
            "maxLength": 120
          },
          "pageKey": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 60
          },
          "head": {
            "$ref": "#/definitions/pageHead"
          }
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "head": {
            "$ref": "#/definitions/pageHead"
          }
        }
      }
    },
    "blog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "productPath": {
      "enum": [
        "/products/:slug/",
        "/shop/:slug/"
      ]
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detailProducts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "slug"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "maxLength": 120
              },
              "head": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "description"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 70,
                    "pattern": "^[^<]*$"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 170,
                    "pattern": "^[^<]*$"
                  }
                }
              },
              "breadcrumbName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[^<]*$"
              },
              "schemas": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "productQuery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "params",
            "values"
          ],
          "properties": {
            "params": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "string",
                "pattern": "^[a-z]{1,20}$"
              }
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              }
            }
          }
        }
      }
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cartSeedPath": {
          "type": "string",
          "pattern": "^/checkout/[a-z0-9-]{1,32}/$"
        },
        "analyticsPath": {
          "type": "string",
          "pattern": "^/api/analytics/[a-z0-9-]{1,32}/$"
        }
      }
    }
  },
  "required": [
    "version"
  ],
  "definitions": {
    "pageHead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "noindex": {
          "type": "boolean"
        }
      }
    }
  }
}
