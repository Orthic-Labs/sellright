{
  "$comment": "BrandHeadSpec (src/platform/head.tsx). Validated by src/platform/brand-data/validate.ts at build; additionalProperties is false everywhere. pageSchemas entries get their own allowlist check (static-schema.ts).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "titleTemplate": { "enum": ["%s | {store}", "%s"] },
    "defaultDescription": { "type": "string", "minLength": 1, "maxLength": 320 },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lowercase", "trailingSlash"],
      "properties": {
        "lowercase": { "type": "boolean" },
        "trailingSlash": { "enum": ["keep", "always"] }
      }
    },
    "favicon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "svg": { "type": "string", "pattern": "^/(?!/)[A-Za-z0-9._~!$&()*+,;=:@%/-]{1,200}$" },
        "ico": { "type": "string", "pattern": "^/(?!/)[A-Za-z0-9._~!$&()*+,;=:@%/-]{1,200}$" },
        "appleTouch": { "type": "string", "pattern": "^/(?!/)[A-Za-z0-9._~!$&()*+,;=:@%/-]{1,200}$" }
      }
    },
    "fontPreloads": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["href", "type"],
        "properties": {
          "href": { "type": "string", "pattern": "^/(?!/)[A-Za-z0-9._~!$&()*+,;=:@%/-]{1,200}$" },
          "type": { "const": "font/woff2" },
          "paths": { "type": "array", "maxItems": 40, "items": { "type": "string", "pattern": "^/[A-Za-z0-9._~!$&()*+,;=:@%/-]{0,200}$" } }
        }
      }
    },
    "imagePreloads": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "type", "srcset", "sizes"],
        "properties": {
          "paths": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "type": "string", "pattern": "^/[A-Za-z0-9._~!$&()*+,;=:@%/-]{0,200}$" } },
          "type": { "enum": ["image/avif", "image/webp", "image/jpeg"] },
          "fetchpriority": { "enum": ["high", "auto"] },
          "srcset": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["href", "width"],
              "properties": {
                "href": { "type": "string", "pattern": "^(?:/brand/(?!/)[A-Za-z0-9._~!$&()*+,;=:@%/-]{1,200}|~/brand/media/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+){0,4}\\.(?:png|jpe?g|webp|avif)\\?(?:[a-z]{1,12}=[A-Za-z0-9]{1,8}&){0,6}url)$" },
                "width": { "type": "integer", "minimum": 1, "maximum": 4096 }
              }
            }
          },
          "sizes": { "type": "string", "pattern": "^[-a-z0-9 ().,%:]{1,120}$" }
        }
      }
    },
    "embeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["youtube"],
      "properties": { "youtube": { "const": true } }
    },
    "googleFontsPreconnect": { "type": "boolean" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facebookDomain": { "type": "string", "pattern": "^[A-Za-z0-9]{10,64}$" },
        "pinterest": { "type": "string", "pattern": "^[A-Za-z0-9]{10,64}$" }
      }
    },
    "analytics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider": { "const": "gtm" },
        "containerId": { "type": "string", "pattern": "^GTM-[A-Z0-9]{4,12}$" },
        "consent": { "enum": ["required", "implied"] },
        "adPlatforms": { "type": "array", "items": { "enum": ["openai"] }, "maxItems": 1 }
      },
      "required": ["provider", "containerId", "consent"]
    },
    "serviceWorker": { "enum": ["register-ios-privacy", "unregister-ios-privacy", "none"] },
    "appleTitle": { "const": "storeName" },
    "ogImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alt": { "type": "boolean" },
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "pageSchemas": {
      "type": "object",
      "propertyNames": { "pattern": "^/[A-Za-z0-9._~!$&()*+,;=:@%/-]{0,200}$" },
      "additionalProperties": { "type": "array", "maxItems": 20, "items": { "type": "object" } }
    }
  }
}
