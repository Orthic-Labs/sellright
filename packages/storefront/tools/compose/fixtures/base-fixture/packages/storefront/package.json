{
	"name": "@sellright/storefront",
	"version": "0.0.0-fixture",
	"scripts": {
		"build": "pnpm run lint && pnpm run clean && pnpm run build.client",
		"prebuild": "pnpm run generate:placeholder-assets",
		"clean": "node scripts/clean.mjs",
		"generate:placeholder-assets": "node scripts/generate-placeholder-assets.mjs",
		"lint": "eslint \"src/**/*.ts*\"",
		"build.client": "vite build --logLevel warn",
		"build.server": "vite build -c adapters/express/vite.config.mts --logLevel warn",
		"serve": "node server/entry.express.js",
		"test:tools": "node --test tools/compose/compose.test.mjs"
	},
	"dependencies": {
		"@sellright/storefront-client": "workspace:*"
	}
}
