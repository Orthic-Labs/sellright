{
	"name": "damned-designs-storefront",
	"description": "A headless commerce storefront for Damned Designs built with Vendure & Qwik",
	"homepage": "https://damneddesigns.com/",
	"license": "UNLICENSED",
	"private": true,
	"type": "module",
	"_comments": {
		"zod": "v4 with classic compat layer — drop-in replacement for v3, zero code changes needed",
		"qwik": "2.0.0-beta.32 — migrated 2026-04-06, icons inlined, manualChunks removed",
		"vite": "Stay on 7.x — Vite 8/Rolldown breaks Qwik SSR (run-ssg.js not generated)"
	},
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"clean": "rm -rf dist server .cache",
		"build": "QWIK_LOG_LEVEL=silent pnpm run lint && pnpm run build.types && pnpm run clean && (sudo systemctl stop dd-worker@1 dd-worker@2 || true) && pnpm run build.client && pnpm run build.server && node scripts/cleanup-static-sitemaps.js && pm2 restart ddstore && sudo systemctl start dd-worker@1 dd-worker@2 && node scripts/purge-cloudflare-cache.js",
		"build.verbose": "qwik build && node scripts/cleanup-static-sitemaps.js",
		"cleanup-sitemaps": "node scripts/cleanup-static-sitemaps.js",
		"build:progress": "./build-with-progress.sh",
		"build.client": "NODE_OPTIONS=\"$(node ../scripts/node-heap-options.mjs --reserve-mb=4096 --max-mb=3072 --min-mb=1536)\" vite build --logLevel warn",
		"build.preview": "NODE_OPTIONS=\"$(node ../scripts/node-heap-options.mjs --reserve-mb=4096 --max-mb=3072 --min-mb=1536)\" vite build --ssr src/entry.preview.tsx --logLevel warn",
		"build.server": "NODE_OPTIONS=\"$(node ../scripts/node-heap-options.mjs --reserve-mb=4096 --max-mb=3072 --min-mb=1536)\" vite build -c adapters/express/vite.config.mts --logLevel warn",
		"prebuild.types": "pnpm run guard:graphql-customer && pnpm run guard:no-graphql-tag",
		"build.types": "tsc --incremental --noEmit",
		"develop": "concurrently pnpm:dev pnpm:dev.server",
		"dev": "vite --mode ssr --port 4100",
		"dev.server": "cd one-click-deploy && yarn dev",
		"dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
		"fmt": "prettier --write .",
		"fmt.check": "prettier --check .",
		"lint": "eslint \"src/**/*.ts*\"",
		"prepare": "husky install",
		"preview": "qwik build preview && vite preview --open",
		"preview:server": "vite preview",
		"serve": "node server/entry.express.js",
		"start": "pnpm generate && vite --open --mode ssr",
		"qwik": "qwik",
		"generate-schema": "cd ../admin && pnpm generate-schema",
		"generate-shop": "pnpm generate-schema && DOTENV_CONFIG_PATH=.env graphql-codegen -r dotenv/config --config codegen-shop.ts",
		"generate-dev": "export IS_DEV=TRUE && pnpm generate-shop",
		"generate-local": "export IS_LOCAL=TRUE && pnpm generate-shop",
		"generate": "pnpm generate-shop",
		"guard:graphql-customer": "bash scripts/guard-graphql-customer.sh",
		"guard:no-graphql-tag": "bash scripts/guard-no-graphql-tag.sh",
		"postinstall": "cp node_modules/@qwik.dev/router/lib/service-worker/index.mjs node_modules/@qwik.dev/router/lib/service-worker.mjs 2>/dev/null || true"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@graphql-codegen/cli": "^7.1.2",
		"@graphql-codegen/introspection": "^6.0.1",
		"@graphql-codegen/typed-document-node": "^7.0.3",
		"@graphql-codegen/typescript": "^6.0.2",
		"@graphql-codegen/typescript-operations": "^6.0.3",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@qwik.dev/core": "2.0.0-beta.35",
		"@qwik.dev/router": "2.0.0-beta.35",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/braintree-web-drop-in": "^1.39.4",
		"@types/compression": "^1.8.1",
		"@types/eslint": "^9.6.1",
		"@types/express": "^5.0.6",
		"@types/node": "^25.9.1",
		"@types/validator": "^13.15.10",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"compression": "^1.8.1",
		"concurrently": "^10.0.3",
		"dotenv": "^17.4.2",
		"eslint": "^10.4.1",
		"eslint-plugin-qwik": "2.0.0-beta.30",
		"express": "^5.2.1",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"postcss": "^8.5.15",
		"prettier": "^3.8.3",
		"pretty-quick": "^4.2.2",
		"tailwindcss": "^4.3.0",
		"terser": "^5.48.0",
		"typescript": "^6.0.3",
		"undici": "^8.3.0",
		"vite": "^7.3.1",
		"vite-imagetools": "^10.0.0",
		"vite-plugin-compression": "^0.5.1",
		"vite-tsconfig-paths": "^6.1.1"
	},
	"dependencies": {
		"@angular/localize": "^21.2.15",
		"@graphql-codegen/typescript-generic-sdk": "^5.0.1",
		"@types/grecaptcha": "^3.0.9",
		"@vendure/payments-plugin": "^3.5.6",
		"card-validator": "^10.0.4",
		"graphql": "^16.14.1",
		"graphql-tag": "^2.12.6",
		"isomorphic-dompurify": "^3.15.0",
		"libphonenumber-js": "^1.13.4",
		"qwik-image": "^2.0.3",
		"us-state-converter": "^1.0.8",
		"validator": "^13.15.35"
	},
	"overrides": {
		"@angular/compiler-cli": {
			"typescript": "5.3.3"
		}
	}
}
