{
	"name": "damned-designs-storefront",
	"description": "A headless commerce storefront for Damned Designs built with Vendure & Qwik",
	"homepage": "https://damneddesigns.com/",
	"license": "UNLICENSED",
	"private": true,
	"type": "module",
	"_comments": {
		"zod": "v4 with classic compat layer — drop-in replacement for v3, zero code changes needed",
		"qwik": "2.0.0-beta.32 — migrated 2026-04-06, icons inlined, manualChunks removed",
		"vite": "Vite 8 must pass Qwik SSR validation before adoption; prior builds did not generate run-ssg.js"
	},
	"engines": {
		"node": ">=24.7 <27",
		"pnpm": ">=11.25 <12"
	},
	"scripts": {
		"clean": "node -e \"const fs=require('fs');for(const p of ['dist','server','.cache'])fs.rmSync(p,{recursive:true,force:true});\"",
		"build": "pnpm run lint && pnpm run build.types && pnpm run clean && pnpm run build.client && pnpm run build.server && node scripts/cleanup-static-sitemaps.js",
		"cleanup-sitemaps": "node scripts/cleanup-static-sitemaps.js",
		"ensure:qwik-service-worker": "node -e \"const fs=require('fs');const src='node_modules/@qwik.dev/router/lib/service-worker/index.mjs';const dest='node_modules/@qwik.dev/router/lib/service-worker.mjs';if(fs.existsSync(src))fs.copyFileSync(src,dest);\"",
		"prebuild.client": "pnpm run ensure:qwik-service-worker",
		"build.client": "vite build --logLevel warn",
		"build.preview": "vite build --ssr src/entry.preview.tsx --logLevel warn",
		"build.server": "vite build -c adapters/express/vite.config.mts --logLevel warn",
		"prebuild.types": "pnpm run guard:graphql-customer && pnpm run guard:no-graphql-tag",
		"build.types": "tsc --incremental --noEmit",
		"dev": "vite --mode ssr --port 4100",
		"fmt": "prettier --write .",
		"fmt.check": "prettier --check .",
		"lint": "eslint \"src/**/*.ts*\"",
		"preview": "qwik build preview && vite preview --open",
		"serve": "node server/entry.express.js",
		"qwik": "qwik",
		"guard:graphql-customer": "bash scripts/guard-graphql-customer.sh",
		"guard:no-graphql-tag": "bash scripts/guard-no-graphql-tag.sh",
		"postinstall": "pnpm run ensure:qwik-service-worker"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@graphql-codegen/cli": "^7.1.3",
		"@graphql-codegen/introspection": "^6.0.1",
		"@graphql-codegen/typed-document-node": "^7.0.3",
		"@graphql-codegen/typescript": "^6.0.2",
		"@graphql-codegen/typescript-operations": "^6.0.5",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@qwik.dev/core": "2.0.0-beta.35",
		"@qwik.dev/router": "2.0.0-beta.35",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/eslint": "^9.6.1",
		"@types/express": "^5.0.6",
		"@types/node": "^25.9.4",
		"@types/validator": "^13.15.10",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"dotenv": "^17.4.2",
		"eslint": "^10.6.0",
		"eslint-plugin-qwik": "2.0.0-beta.30",
		"express": "^5.2.1",
		"globals": "^17.7.0",
		"postcss": "^8.5.16",
		"prettier": "^3.9.4",
		"tailwindcss": "^4.3.2",
		"terser": "^5.48.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.5",
		"vite-imagetools": "^10.0.1",
		"vite-plugin-compression": "^0.5.1",
		"vite-tsconfig-paths": "^6.1.1"
	},
	"dependencies": {
		"@stripe/stripe-js": "^9.15.0",
		"card-validator": "^10.0.4",
		"graphql": "^16.14.2",
		"graphql-tag": "^2.12.7",
		"isomorphic-dompurify": "^3.18.0",
		"libphonenumber-js": "^1.13.8",
		"qwik-image": "^2.0.3",
		"us-state-converter": "^1.0.8",
		"validator": "^13.15.35"
	}
}
