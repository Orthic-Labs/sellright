# SellRight storefront env — copy to `packages/storefront/.env`.

# --- Vite client / SSR API targeting ----------------------------------------
VITE_SELLRIGHT_API_URL=http://127.0.0.1:3300
VITE_SELLRIGHT_STORE_SLUG=damned

# --- SSR runtime -------------------------------------------------------------
HOST=0.0.0.0
PORT=4100
STOREFRONT_ORIGIN=https://store.example.com
VENDURE_API_URL=http://localhost:3100/shop-api
CATALOG_DIR=/home/vendure/sites/sellright-data

# --- Optional integrations ---------------------------------------------------
LISTMONK_INTERNAL_URL=
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_TOKEN=
LISTMONK_LIST_ID_DAMNED=
CACHE_ADMIN_TOKEN=
CACHE_WARM_TOKEN=
VITE_TURNSTILE_SITE_KEY=
