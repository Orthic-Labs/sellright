# SellRight storefront env — copy to `packages/storefront/.env`.

# --- Vite client / SSR API targeting ----------------------------------------
VITE_SELLRIGHT_API_URL=http://127.0.0.1:3300
VITE_SELLRIGHT_STORE_SLUG=damned

# Server-authoritative cart (strangler flag, cart-architecture plan Phase B).
# Unset/0 → localStorage-only LocalCartService (legacy). 1/true → ServerCartService
# (cart token in the sr_cart cookie; server-priced). Flag-OFF rollback is lossless:
# the legacy vendure_local_cart localStorage key is preserved while the flag is on.
VITE_SERVER_CART=0

# SellRight + Stripe checkout (strangler flag, checkout-migration plan 2026-06-20).
# Unset/0 → the legacy Vendure/NMI/Sezzle checkout path (DEFAULT). 1/true → the
# SellRight REST checkout: POST /checkout from the sr_cart token, a Stripe
# PaymentIntent, the Stripe Payment Element, webhook-authoritative settlement,
# and a receipt-token-scoped confirmation read. DO NOT flip to default until a
# real Stripe test-mode transaction has been verified by a human on the box.
VITE_SR_CHECKOUT=0

# --- SSR runtime -------------------------------------------------------------
HOST=0.0.0.0
PORT=4100
STOREFRONT_ORIGIN=https://store.example.com
VENDURE_API_URL=http://localhost:3100/shop-api
CATALOG_DIR=/home/vendure/sites/sellright-data

# --- Optional integrations ---------------------------------------------------
LISTMONK_INTERNAL_URL=
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_TOKEN=
LISTMONK_LIST_ID_DAMNED=
CACHE_ADMIN_TOKEN=
CACHE_WARM_TOKEN=
VITE_TURNSTILE_SITE_KEY=
