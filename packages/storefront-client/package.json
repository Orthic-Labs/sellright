{
  "name": "@sellright/storefront-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native typed REST client for the SellRight API — types generated from /v1/openapi.json, no GraphQL.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vite": "8.3.4",
    "vitest": "^4.1.12"
  }
}
