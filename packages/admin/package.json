{
  "name": "@sellright/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25",
    "pnpm": ">=11.25 <12"
  },
  "scripts": {
    "dev": "vite",
    "qa:browser": "vite --mode qa --host 127.0.0.1 --port 4300",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --port 4200 --host",
    "e2e:build": "SELLRIGHT_BUILD_SUFFIX=e2e vite build",
    "test:e2e": "pnpm run e2e:build && playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
