{
  "name": "@sellright/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7 <25",
    "pnpm": ">=11.25 <12"
  },
  "scripts": {
    "dev": "vite",
    "qa:browser": "vite --mode qa --host 127.0.0.1 --port 4300",
