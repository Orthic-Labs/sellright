{
  "name": "@sellright/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "db:generate": "drizzle-kit generate",
    "postdb:generate": "node scripts/assert-no-partial-index-drop.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node dist/scripts/migrate.js",
    "bootstrap:runtime": "node dist/scripts/bootstrap.js",
    "db:assert-rls": "tsx src/db/assert-force-rls.ts",
    "db:assert-hand-written": "tsx src/db/assert-hand-written-migrations.ts",
    "assert:shop-isolation": "node scripts/assert-shop-route-isolation.mjs",
    "import:preflight": "tsx src/import/preflight.ts",
    "import:vendure": "tsx src/import/run.ts",
    "import:restore": "tsx src/import/restore.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@rightkit/legal": "0.3.1",
    "@xmldom/xmldom": "0.9.12",
    "bcryptjs": "3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "^4.1.9"
  }
}
