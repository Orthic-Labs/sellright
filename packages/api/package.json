{
  "name": "@sellright/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    },
    "./db": {
      "types": "./dist/exports/db.d.ts",
      "default": "./dist/exports/db.js"
    },
    "./schema": {
      "types": "./dist/exports/schema.d.ts",
      "default": "./dist/exports/schema.js"
    },
    "./auth": {
      "types": "./dist/exports/auth.d.ts",
      "default": "./dist/exports/auth.js"
    },
    "./http": {
      "types": "./dist/exports/http.d.ts",
      "default": "./dist/exports/http.js"
    },
    "./log": {
      "types": "./dist/exports/log.d.ts",
      "default": "./dist/exports/log.js"
    },
    "./payments": {
      "types": "./dist/exports/payments.d.ts",
      "default": "./dist/exports/payments.js"
    },
    "./licensing": {
      "types": "./dist/exports/licensing.d.ts",
      "default": "./dist/exports/licensing.js"
    },
    "./storekit": {
      "types": "./dist/exports/storekit.d.ts",
      "default": "./dist/exports/storekit.js"
    },
    "./ops": {
      "types": "./dist/exports/ops.d.ts",
      "default": "./dist/exports/ops.js"
    },
    "./exports/contract.json": "./exports/contract.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "drizzle",
    "exports",
    "BUILD-INFO.json"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/write-build-info.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "db:generate": "drizzle-kit generate",
    "postdb:generate": "node scripts/assert-no-partial-index-drop.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node dist/scripts/migrate.js",
    "bootstrap:runtime": "node dist/scripts/bootstrap.js",
    "db:assert-rls": "tsx src/db/assert-force-rls.ts",
    "db:assert-hand-written": "tsx src/db/assert-hand-written-migrations.ts",
    "assert:shop-isolation": "node scripts/assert-shop-route-isolation.mjs",
    "assert:settlement": "node scripts/assert-settlement-chokepoint.mjs",
    "assert:locks": "node scripts/assert-lock-order.mjs",
    "effects:worker": "node dist/scripts/effects-worker.js",
    "import:preflight": "tsx src/import/preflight.ts",
    "import:vendure": "tsx src/import/run.ts",
    "import:restore": "tsx src/import/restore.ts",
    "pack:artifact": "pnpm build && pnpm pack",
    "gen:exports-contract": "node scripts/gen-exports-contract.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@rightkit/legal": "0.3.1",
    "@xmldom/xmldom": "0.9.12",
    "bcryptjs": "3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "^4.1.9"
  }
}
