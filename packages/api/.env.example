# SellRight API env — this file lives beside the API package as `packages/api/.env`.
# Keep it in-checkout and gitignored, like the other sites.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3300

# Runtime app connection (non-owner role in production; owner is fine in local dev).
DATABASE_URL=postgres://sellright:CHANGE_ME@127.0.0.1:5433/sellright_dev
# Optional: owner connection used by deploy/migration scripts that source this file.
DATABASE_URL_OWNER=postgres://sellright:CHANGE_ME@127.0.0.1:5433/sellright_dev
# Optional: explicit non-owner URL for FORCE-RLS tests.
DATABASE_URL_NONOWNER=postgres://sellright_app:CHANGE_ME@127.0.0.1:5433/sellright_dev

# --- Email ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sellright.local
SMTP_ENABLED=

# --- Assets / links ---------------------------------------------------------
ASSET_DIR=/home/vendure/sites/sellright-assets
STOREFRONT_URL=https://store.example.com

# --- Stripe -----------------------------------------------------------------
# Prefer the explicit dual-key setup. The legacy single-key vars are still read
# as a fallback during migration, but new deployments should fill the *_TEST and
# *_LIVE slots instead.
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=

# Legacy fallback (optional during migration only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Auth -------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# --- Admin bootstrap ---------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Import scripts ----------------------------------------------------------
SOURCE_DATABASE_URL=postgres://cp:cp@127.0.0.1:5433/damned_vendure
ALLOW_FORCE_TRUNCATE=

# --- Manifest / multi-store --------------------------------------------------
CATALOG_DIR=/home/vendure/sites/sellright-data
STORE_SLUG=damned

# --- Jobs -------------------------------------------------------------------
JOBS_ENABLED=
JOBS_AUTO_DELIVER_APPLY=
JOBS_AUTO_DELIVER_DAYS=10
JOBS_RELEASE_STALE_APPLY=
JOBS_RELEASE_STALE_TTL_MIN=60
JOBS_WEBHOOK_REAPER_APPLY=
JOBS_WEBHOOK_REAPER_GRACE_MIN=10
