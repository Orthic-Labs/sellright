# Copy to deploy/.env before `docker compose --env-file deploy/.env -f deploy/compose.yaml up -d --build`.
# Keep deploy/.env out of git. Generate random secrets; do not reuse examples.

# Public SellRight admin/API hostname. Point DNS A/AAAA at this server; Caddy
# obtains and renews TLS automatically.
SELLRIGHT_DOMAIN=sellright.yourdomain.com

# Public customer-facing storefront URL used in email links.
STOREFRONT_URL=https://shop.yourdomain.com

# Use a URL-safe random value (hex/base64url) because Compose embeds this in the
# DATABASE_URL. Example generator: `openssl rand -hex 32`.
POSTGRES_PASSWORD=CHANGE_ME_64_HEX

# First-run bootstrap. The bootstrap is create-only: later container restarts do
# not reset an existing admin password or overwrite store settings.
ADMIN_EMAIL=owner@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
BOOTSTRAP_STORE_SLUG=main
BOOTSTRAP_STORE_NAME=My Store
BOOTSTRAP_STORE_CURRENCY=USD
# Comma-separated customer-facing hosts allowed to resolve/CORS to this store.
BOOTSTRAP_STORE_HOSTNAMES=shop.yourdomain.com

# Required for signed licensed-download URLs. Example: `openssl rand -hex 32`.
DOWNLOAD_URL_SECRET=CHANGE_ME_64_HEX

# Stripe: bootstrap starts in TEST mode. Configure the test triplet, perform a
# real Stripe test transaction end-to-end, then add live keys and explicitly
# switch the store's Stripe mode to live in admin. Never paste a live key into a
# *_TEST slot or vice versa; SellRight rejects mode-mismatched keys.
STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=

# Mail. Leave SMTP_HOST empty to disable sending; the email outbox remains safe.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Background jobs. Dangerous state-changing jobs retain their own APPLY flags
# and default dry-run/off even when the scheduler itself is enabled.
JOBS_ENABLED=1
JOBS_PUSH_ENABLED=0

# Set to 1 only when the public hostname is actually proxied through Cloudflare;
# then the API trusts CF-Connecting-IP. Direct Caddy deployments should stay 0.
BEHIND_CLOUDFLARE=0

# Tune only after measuring pool wait time and Postgres connection capacity.
PGPOOL_MAX=10
PGPOOL_CONNECTION_TIMEOUT_MS=5000
