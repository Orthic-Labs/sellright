{
    servers {
        # Cloudflare ranges fetched 2026-10-16: https://www.cloudflare.com/ips/
        # Trust CF-Connecting-IP only on sockets owned by Cloudflare. Direct-origin headers are ignored.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
        trusted_proxies_strict
    }
}

{$SELLRIGHT_DOMAIN} {
    encode zstd gzip

    # Caddy resolves visitor identity from trusted Cloudflare sockets or the direct peer,
    # then replaces X-Real-IP & strips the public header before forwarding privately.
    reverse_proxy admin:8080 {
        header_up X-Real-IP {client_ip}
        # The edge never forwards a client-supplied CF-Connecting-IP: behind it the API (and storefront) would
        # otherwise trust a forged per-request identity when BEHIND_CLOUDFLARE=1 (security audit P1a).
        header_up -CF-Connecting-IP
    }
}

# WS-C shipped a generic runtime-config storefront image (resolves store
# identity per-request Host against the API — see packages/storefront/
# adapters and routes/layout.tsx), so this Caddy block's own per-Host routing
# to multiple stores is now a Caddy-side follow-up, not blocked on the image.
# Still opt-in for this PR (WS-D): it only binds when
# SELLRIGHT_STOREFRONT_DOMAIN is set in deploy/.env, so installs that don't
# set it get byte-identical behavior to before the storefront service existed.
{$SELLRIGHT_STOREFRONT_DOMAIN:-:8090} {
    encode zstd gzip

    reverse_proxy storefront:4100 {
        header_up X-Real-IP {client_ip}
        # The edge never forwards a client-supplied CF-Connecting-IP: behind it the API (and storefront) would
        # otherwise trust a forged per-request identity when BEHIND_CLOUDFLARE=1 (security audit P1a).
        header_up -CF-Connecting-IP
    }
}
